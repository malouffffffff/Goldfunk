<section class="jf-instagram color-{{ section.settings.color_scheme }}">
  <div class="jf-instagram__intro">
    <span class="jf-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.instagram_link != blank %}
      <a class="jf-link" href="{{ section.settings.instagram_link }}" target="_blank" rel="noopener">{{ section.settings.handle }}</a>
    {% else %}
      <span class="jf-link">{{ section.settings.handle }}</span>
    {% endif %}
  </div>

  {% comment %}
    The posts come from an Instagram feed app (theme app block). The app holds the Instagram
    access token on its own servers and refreshes the feed, so nothing secret lives in the theme.
  {% endcomment %}
  {% if section.blocks.size > 0 %}
    <div class="jf-instagram__feed">
      {% for block in section.blocks %}
        {% render block %}
      {% endfor %}
    </div>
  {% elsif request.design_mode %}
    <p class="jf-instagram__notice">Noch kein Instagram-Feed verbunden: Installiere eine Instagram-Feed-App und füge hier über „Block hinzufügen“ ihren App-Block ein.</p>
  {% endif %}
</section>

{% stylesheet %}
  .jf-instagram__feed { margin: auto; max-width: 1440px; }
  .jf-instagram__notice { border: 1px dashed currentColor; margin: auto; max-width: 36rem; opacity: .7; padding: 1.5rem; text-align: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "JewelleryFunk – Instagram",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Instagram" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Follow us on Instagram." },
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "@jewelleryfunk" },
    { "type": "url", "id": "instagram_link", "label": "Instagram link" },
    { "type": "paragraph", "content": "Die Posts kommen automatisch aus einer Instagram-Feed-App. Nach der Installation den App-Block über „Block hinzufügen“ in diese Section einfügen." }
  ],
  "blocks": [
    { "type": "@app" }
  ],
  "presets": [{ "name": "JewelleryFunk – Instagram" }]
}
{% endschema %}
