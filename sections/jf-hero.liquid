{% liquid
  assign hero_image = section.settings.hero_image
  assign band_image_count = 0
  for image_index in (1..20)
    assign image_setting = 'band_image_' | append: image_index
    if section.settings[image_setting] != blank
      assign band_image_count = band_image_count | plus: 1
    endif
  endfor

  if band_image_count <= 3
    assign band_repeat_count = 24
  elsif band_image_count <= 8
    assign band_repeat_count = 12
  elsif band_image_count <= 14
    assign band_repeat_count = 8
  else
    assign band_repeat_count = 6
  endif
%}

<div class="jf-home" id="jf-home-{{ section.id }}" style="--jf-home-hero-color: {{ section.settings.hero_color_scheme.settings.background }}; --jf-home-hero-foreground: {{ section.settings.hero_color_scheme.settings.foreground }};">
  <section class="jf-hero jf-hero--collage color-{{ section.settings.hero_color_scheme }}" aria-label="{{ section.settings.hero_heading | strip_html | escape }}" style="--jf-hero-scroll-height: {{ section.settings.hero_scroll_length }}svh;">
    <div class="jf-hero__sticky">
      {% if section.settings.hero_background_image != blank %}
        <div class="jf-hero__background" style="--jf-bg-width: {{ section.settings.hero_background_width }}%; --jf-bg-height: {{ section.settings.hero_background_height }}%; --jf-bg-x: {{ section.settings.hero_background_x }}%; --jf-bg-y: {{ section.settings.hero_background_y }}%;">
          {{ section.settings.hero_background_image | image_url: width: 2800 | image_tag: widths: '750, 1100, 1600, 2200, 2800', loading: 'eager', fetchpriority: 'high', alt: '' }}
        </div>
      {% endif %}
      <div class="jf-hero__wash"></div>
      <div class="jf-hero__collage" aria-hidden="true">
        <div class="jf-hero__bands">
          {% for band_index in (1..4) %}
            <div class="jf-hero__band jf-hero__band--{{ band_index }}" data-jf-hero-band>
              <div class="jf-hero__band-track">
                {% for repeat_index in (1..band_repeat_count) %}
                  {% for image_index in (1..20) %}
                    {% assign image_setting = 'band_image_' | append: image_index %}
                    {% assign band_image = section.settings[image_setting] %}
                    {% if band_image != blank %}
                      <div class="jf-hero__band-image">
                        {{ band_image | image_url: width: 700 | image_tag: widths: '240, 360, 520, 700', loading: 'lazy', alt: '' }}
                      </div>
                    {% endif %}
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </div>
        {% if hero_image != blank %}
          <figure class="jf-hero__card jf-hero__card--main">
            {{ hero_image | image_url: width: 2200 | image_tag: widths: '750, 1100, 1600, 2200', loading: 'eager', fetchpriority: 'high', alt: '' }}
            {% if section.settings.hero_logo_image != blank %}
              <div class="jf-hero__logo-mark jf-hero__logo-mark--{{ section.settings.hero_logo_position }}" style="--jf-logo-size: {{ section.settings.hero_logo_size }}vw;">
                {{ section.settings.hero_logo_image | image_url: width: 1000 | image_tag: widths: '240, 480, 750, 1000', loading: 'eager', alt: section.settings.hero_logo_image.alt | default: shop.name }}
              </div>
            {% endif %}
          </figure>
        {% endif %}
        {% if hero_image == blank %}<div class="jf-hero__fallback jf-hero__card jf-hero__card--main"></div>{% endif %}
      </div>
      <div class="jf-hero__inner">
        <span class="jf-eyebrow">{{ section.settings.hero_eyebrow }}</span>
        <h1>{{ section.settings.hero_heading }}</h1>
        {% if section.settings.hero_copy != blank %}<p class="jf-hero__copy">{{ section.settings.hero_copy }}</p>{% endif %}
        {% if section.settings.hero_link != blank %}<a class="jf-button" href="{{ section.settings.hero_link }}">{{ section.settings.hero_button }}</a>{% endif %}
      </div>
      <span class="jf-hero__scroll">Scroll to discover</span>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "JewelleryFunk – Hero",
  "settings": [
    { "type": "color_scheme", "id": "hero_color_scheme", "label": "Hero color scheme", "default": "scheme-4" },
    { "type": "image_picker", "id": "hero_image", "label": "Main hero image" },
    { "type": "image_picker", "id": "hero_background_image", "label": "Hero background image" },
    { "type": "range", "id": "hero_background_width", "label": "Background image width", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "hero_background_height", "label": "Background image height", "min": 50, "max": 200, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "hero_background_x", "label": "Background image horizontal position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "hero_background_y", "label": "Background image vertical position", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "header", "content": "Moving image bands" },
    { "type": "paragraph", "content": "Add up to 20 images here. They repeat seamlessly in the four moving bands around the main image." },
    { "type": "image_picker", "id": "band_image_1", "label": "Band image 01" },
    { "type": "image_picker", "id": "band_image_2", "label": "Band image 02" },
    { "type": "image_picker", "id": "band_image_3", "label": "Band image 03" },
    { "type": "image_picker", "id": "band_image_4", "label": "Band image 04" },
    { "type": "image_picker", "id": "band_image_5", "label": "Band image 05" },
    { "type": "image_picker", "id": "band_image_6", "label": "Band image 06" },
    { "type": "image_picker", "id": "band_image_7", "label": "Band image 07" },
    { "type": "image_picker", "id": "band_image_8", "label": "Band image 08" },
    { "type": "image_picker", "id": "band_image_9", "label": "Band image 09" },
    { "type": "image_picker", "id": "band_image_10", "label": "Band image 10" },
    { "type": "image_picker", "id": "band_image_11", "label": "Band image 11" },
    { "type": "image_picker", "id": "band_image_12", "label": "Band image 12" },
    { "type": "image_picker", "id": "band_image_13", "label": "Band image 13" },
    { "type": "image_picker", "id": "band_image_14", "label": "Band image 14" },
    { "type": "image_picker", "id": "band_image_15", "label": "Band image 15" },
    { "type": "image_picker", "id": "band_image_16", "label": "Band image 16" },
    { "type": "image_picker", "id": "band_image_17", "label": "Band image 17" },
    { "type": "image_picker", "id": "band_image_18", "label": "Band image 18" },
    { "type": "image_picker", "id": "band_image_19", "label": "Band image 19" },
    { "type": "image_picker", "id": "band_image_20", "label": "Band image 20" },
    { "type": "image_picker", "id": "hero_logo_image", "label": "Logo on main image" },
    { "type": "select", "id": "hero_logo_position", "label": "Logo position", "default": "bottom-right", "options": [ { "value": "top-left", "label": "Top left" }, { "value": "top-right", "label": "Top right" }, { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-right", "label": "Bottom right" } ] },
    { "type": "range", "id": "hero_logo_size", "label": "Logo size", "min": 10, "max": 38, "step": 1, "unit": "vw", "default": 20 },
    { "type": "range", "id": "hero_scroll_length", "label": "Hero scroll length", "min": 200, "max": 800, "step": 50, "unit": "%", "default": 500 },
    { "type": "text", "id": "hero_eyebrow", "label": "Hero eyebrow", "default": "JewelleryFunk — est. 2024" },
    { "type": "textarea", "id": "hero_heading", "label": "Hero heading", "default": "Made to be remembered." },
    { "type": "textarea", "id": "hero_copy", "label": "Hero copy", "default": "Modern heirlooms, designed to move with you." },
    { "type": "text", "id": "hero_button", "label": "Hero button", "default": "Explore the collection" },
    { "type": "url", "id": "hero_link", "label": "Hero link" }
  ],
  "presets": [{ "name": "JewelleryFunk – Hero" }]
}
{% endschema %}
