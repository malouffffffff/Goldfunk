<section class="jf-about color-{{ section.settings.color_scheme }}">
  <header class="jf-about__hero">
    <div class="jf-about__hero-copy">
      <span class="jf-eyebrow">{{ section.settings.eyebrow }}</span>
      <h1>{{ section.settings.heading }}</h1>
      <div class="jf-about__intro rte">{{ section.settings.intro }}</div>
      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a class="jf-button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
      {% endif %}
    </div>
    <div class="jf-about__hero-image">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 2200 | image_tag: widths: '700, 1000, 1500, 2200', loading: 'eager', alt: section.settings.image.alt | default: section.settings.heading }}
      {% else %}
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  </header>

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'story' %}
        <article class="jf-about__story" {{ block.shopify_attributes }}>
          <span class="jf-eyebrow">{{ block.settings.eyebrow }}</span>
          <h2>{{ block.settings.heading }}</h2>
          <div class="jf-about__body rte">{{ block.settings.text }}</div>
        </article>
      {% when 'image' %}
        <figure class="jf-about__image" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 2200 | image_tag: widths: '700, 1000, 1500, 2200', loading: 'lazy', alt: block.settings.image.alt | default: shop.name }}
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {% endif %}
          {% if block.settings.caption != blank %}<figcaption>{{ block.settings.caption }}</figcaption>{% endif %}
        </figure>
    {% endcase %}
  {% endfor %}
</section>

{% stylesheet %}
  .jf-about { background: var(--color-background, #fcfbf8); color: var(--color-foreground, #20201e); padding-bottom: clamp(6rem, 12vw, 12rem); }
  .jf-about__hero { display: grid; grid-template-columns: minmax(18rem, .9fr) minmax(0, 1.1fr); min-height: min(48rem, 78svh); }
  .jf-about__hero-copy { align-content: center; display: grid; justify-items: start; padding: clamp(7rem, 13vw, 14rem) clamp(1.5rem, 8vw, 10rem) clamp(4rem, 8vw, 8rem); }
  .jf-about h1, .jf-about h2 { font-family: "Iowan Old Style", "Baskerville", Georgia, serif; font-weight: 400; letter-spacing: -.045em; line-height: .88; }
  .jf-about h1 { font-size: clamp(3.8rem, 7.4vw, 8.5rem); margin: 1rem 0 1.8rem; max-width: 8ch; }
  .jf-about__intro { font-size: clamp(1rem, 1.2vw, 1.2rem); line-height: 1.75; margin-bottom: 2.2rem; max-width: 31rem; }
  .jf-about__hero-image { min-height: 32rem; }
  .jf-about__hero-image img, .jf-about__image img { display: block; height: 100%; object-fit: cover; width: 100%; }
  .jf-about__story { margin: clamp(6rem, 14vw, 13rem) auto; max-width: 47rem; padding: 0 1.5rem; }
  .jf-about__story h2 { font-size: clamp(3rem, 6vw, 6.8rem); margin: 1rem 0 2rem; max-width: 8ch; }
  .jf-about__body { font-size: clamp(1rem, 1.2vw, 1.22rem); line-height: 1.8; max-width: 39rem; }
  .jf-about__body p + p { margin-top: 1.2rem; }
  .jf-about__image { margin: clamp(5rem, 10vw, 10rem) auto; max-width: min(92vw, 105rem); }
  .jf-about__image img { aspect-ratio: 1.65; }
  .jf-about__image figcaption { font-size: .65rem; letter-spacing: .12em; margin-top: .8rem; text-transform: uppercase; }
  @media (max-width: 749px) {
    .jf-about__hero { grid-template-columns: 1fr; }
    .jf-about__hero-copy { padding-top: 8rem; }
    .jf-about__hero-image { min-height: 27rem; }
    .jf-about__image img { aspect-ratio: .85; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JF About us",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "JewelleryFunk" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Objects for the moments that become yours." },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Write the beginning of your JewelleryFunk story here.</p>" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story text",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our point of view" },
        { "type": "textarea", "id": "heading", "label": "Heading", "default": "Made for expression." },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use this space for your story, your process, your materials or the people behind JewelleryFunk.</p>" }
      ]
    },
    {
      "type": "image",
      "name": "Full-width image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "presets": [{
    "name": "JF About us",
    "blocks": [{ "type": "story" }, { "type": "image" }, { "type": "story" }]
  }]
}
{% endschema %}
